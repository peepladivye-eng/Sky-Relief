# LLM / VLM backend (OpenAI-compatible)
LLM_BASE_URL=https://api.studio.nebius.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct

# Set to 1 to enable live Sentinel/Open-Meteo/Overpass fetching
LIVE_DATA=0

# Frontend API URL (set to deployed API URL for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth (generate a long random string for SKYRELIEF_SESSION_SECRET)
SKYRELIEF_SESSION_SECRET=change-this-to-a-random-string-of-at-least-32-chars
# JSON array of {email, passwordHash} — hash passwords with bcryptjs
SKYRELIEF_DEMO_USERS=[{"email":"demo@skyrelief.app","passwordHash":"$2a$10$REPLACE_WITH_BCRYPT_HASH"}]

# Optional: custom muted map style (check provider TOS before use)
NEXT_PUBLIC_MAP_STYLE_URL=
